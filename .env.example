# ==============================================================================
# Counterfactual Multi-Agent Supply Chain Management System
# Environment Configuration Template (.env.example)
# Copy this file to .env and adjust variables for your local or docker environment.
# ==============================================================================

# Application Meta
PROJECT_NAME="Counterfactual Multi-Agent Supply Chain System"
VERSION="1.0.0"
ENVIRONMENT="development"

# Security & Authentication
SECRET_KEY="replace-with-a-secure-random-64-character-hex-string-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite default:
DATABASE_URL="sqlite:///./supply_chain.db"
# PostgreSQL in Docker Compose:
# DATABASE_URL="postgresql://postgres:postgres@db:5432/supply_chain"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_secure_password"
POSTGRES_DB="supply_chain"

# Centralized LLM Provider Routing Priority
# Options: "groq" (Cloud Primary) or "ollama" (Local Primary)
LLM_PRIMARY_PROVIDER="groq"
LLM_FALLBACK_ENABLED=true
LLM_REQUEST_TIMEOUT=12.0

# Primary Cloud LLM: Groq Cloud API
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_PRIMARY_MODEL="llama-3.3-70b-versatile"
GROQ_FALLBACK_MODEL="llama-3.1-8b-instant"

# Local LLM: Ollama Engine
# For local host execution: http://localhost:11434
# For Docker Compose execution: http://ollama:11434
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"
OLLAMA_FALLBACK_MODEL="llama3"

# Networking & Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
